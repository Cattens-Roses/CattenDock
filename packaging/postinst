#!/bin/bash
set -e

APP_DIR=/opt/cattendock
DATA_DIR=$APP_DIR/data
VENV=$APP_DIR/backend/venv
WHEELS=$APP_DIR/wheels

case "$1" in
  configure)
    if ! getent group cattendock >/dev/null; then
      addgroup --system cattendock
    fi
    if ! getent passwd cattendock >/dev/null; then
      adduser --system --ingroup cattendock --home "$APP_DIR" \
        --no-create-home --disabled-login --gecos "CattenDock" cattendock
    fi

    mkdir -p "$DATA_DIR"
    chown -R cattendock:cattendock "$DATA_DIR"

    if getent group docker >/dev/null; then
      usermod -aG docker cattendock || true
    fi

    if [ ! -d "$VENV" ]; then
      python3 -m venv "$VENV"
    fi
    "$VENV/bin/pip" install --upgrade pip wheel >/dev/null
    "$VENV/bin/pip" install \
      --no-index --find-links "$WHEELS" \
      -r "$APP_DIR/backend/requirements.txt"
    chown -R root:root "$VENV"

    systemctl daemon-reload
    systemctl enable cattendock >/dev/null 2>&1 || true
    systemctl restart cattendock || true
    ;;
esac

exit 0
